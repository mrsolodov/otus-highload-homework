Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_check_update = false
  config.vm.synced_folder ".", "/vagrant", disabled: true

  machines = {
    "nginx1" => ["192.168.56.11", 512, 2211],
    "nginx2" => ["192.168.56.12", 512, 2212],
    "app1"   => ["192.168.56.21", 1536, 2221],
    "app2"   => ["192.168.56.22", 1536, 2222],
    "db1"    => ["192.168.56.30", 1024, 2230]
  }

  machines.each do |name, (ip, memory, ssh_port)|
    config.vm.define name do |machine|
      machine.vm.hostname = name
      machine.vm.network "private_network", ip: ip
      machine.vm.network "forwarded_port", guest: 22, host: ssh_port, id: "ssh", auto_correct: false
      machine.vm.provider "virtualbox" do |vb|
        vb.name = "otus-10-#{name}"
        vb.memory = memory
        vb.cpus = 1
      end
      machine.vm.provider "libvirt" do |lv|
        lv.memory = memory
        lv.cpus = 1
      end
    end
  end
end
