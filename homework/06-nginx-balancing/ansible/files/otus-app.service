[Unit]
Description=OTUS uWSGI demo app
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
ExecStart=/usr/bin/uwsgi --plugin python3 --http-socket 127.0.0.1:8000 --wsgi-file /srv/otus-app/app.py --callable application --master --processes 2 --threads 2 --die-on-term
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
