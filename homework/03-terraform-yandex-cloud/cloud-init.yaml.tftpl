#cloud-config
package_update: true

packages:
  - nginx

write_files:
  - path: /var/www/html/index.html
    permissions: "0644"
    content: |
      <!doctype html>
      <html lang="ru">
        <head>
          <meta charset="utf-8">
          <title>OTUS Terraform</title>
        </head>
        <body>
          <h1>${vm_name}</h1>
          <p>Виртуальная машина создана с помощью Terraform.</p>
          <p>Nginx настроен через cloud-init.</p>
        </body>
      </html>

runcmd:
  - [systemctl, enable, --now, nginx]
